# ============================================
# NomadSync Backend Configuration Template
# ============================================
# Copy this file to .env and update values as needed for your environment.
# DO NOT commit .env to version control.

# ============================================
# MongoDB Configuration
# ============================================
# MongoDB connection URI
# For local development: mongodb://localhost:27017
# For Docker: mongodb://mongodb:27017
# For production with auth: mongodb://username:password@host:27017
MONGODB_URI=mongodb://localhost:27017

# Database name
MONGODB_DB=nomadsync

# ============================================
# JWT Authentication Configuration
# ============================================
# Secret key for JWT token signing (REQUIRED for production)
# Generate a secure secret: openssl rand -hex 32
JWT_SECRET=your-secret-key-change-in-production

# JWT algorithm (typically HS256)
JWT_ALGORITHM=HS256

# Access token expiration time in minutes (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token expiration time in days (default: 30)
REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins for CORS
# For local development with Vite: http://localhost:5173
# Multiple origins: http://localhost:5173,http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# OpenAI Configuration
# ============================================
# OpenAI API key (REQUIRED for agent features)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI model to use (default: gpt-4o-mini)
# Options: gpt-4o-mini, gpt-4o, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini
